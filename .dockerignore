# Keep the build context small, and keep secrets and personal data out of the
# image.
**/node_modules
**/dist
.git
.gitignore
_archive
project_logs
docs
specs
skills-lock.json

# Database backups taken from a live system may contain real accounts, email
# addresses, and password hashes. Keep versioned schema/migration/seed SQL, but
# reject backup artefacts at every directory depth.
**/*.dump
**/*.bak
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.sql.gz
**/*.zip
**/*.tar.gz
**/*backup*.sql
**/*dump*.sql

# One-off migration tools are development records and are never runtime input.
server/scripts/archive
scripts

**/.env
**/.env.*

# Uploaded files belong on a mounted volume, not baked into the image.
server/uploads
**/npm-debug.log*
