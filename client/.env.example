# Front-end build inputs. Vite inlines anything starting with VITE_ into the
# bundle at build time, so treat every value here as public - never put a
# secret in this file.

# Where the API lives. Leave EMPTY for the normal deployment, where the API
# server also serves this bundle and everything is same-origin. Set it only if
# the API is on a different host, e.g. https://api.example.com (no trailing
# slash).
VITE_API_BASE_URL=

# Google sign-in. The origin the app is served from must be listed under
# "Authorized JavaScript origins" for this client id, or sign-in returns 403.
VITE_GOOGLE_CLIENT_ID=
