# Local language model (Spec 0004): Ollama's OpenAI-compatible endpoint.
# No AI provider key is used. Leave LLM_BASE_URL or a job's model empty to turn
# that job off; it then uses its built-in fallback.
#   - local dev with Ollama for Windows: http://localhost:11434/v1
#   - inside docker compose:              http://ollama:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
# Lumi chat + AI exercise/challenge generator
LLM_CHAT_MODEL=scb10x/typhoon2.5-qwen3-4b
LLM_TIMEOUT_MS=45000

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=moonshotai/kimi-k2.5
# Used only by the Arcade Battle Royale readability judge (server.js
# callClaudeForReadability) — separate from the NVIDIA integration above.
# Falls back to a heuristic score automatically if left unset.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password_here
DB_CLIENT=postgres
PGHOST=localhost
PGPORT=1234
PGUSER=postgres
PGPASSWORD=
PGDATABASE=DB_2.0

# Chatbot AI (Lumi chat + AI exercise/challenge generator), via NVIDIA's
# OpenAI-compatible endpoint at https://integrate.api.nvidia.com/v1.
# Keep this separate from the code judges below: they grade code inside live
# matches and must not share a budget.
# Both features fall back to built-in content when this is unset.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_AI_MODEL=moonshotai/kimi-k3
NVIDIA_AI_TIMEOUT_MS=90000

# Competitive Arena submission judge. Separate key AND separate model from the
# chatbot above on purpose: it runs inside live matches, so its token budget is
# not spare capacity for anything else. Leave both blank to disable it -
# answers are then scored in-process and no player's code leaves the server.
NVIDIA_CODE_JUDGE_API_KEY=
NVIDIA_CODE_JUDGE_MODEL=

# Arcade post-match advice (server/arcade/code-judge.js, ADR 0007): Gemini writes
# a few sentences of advice on a finished round. It never scores: quality is
# measured locally (arcade/code-metrics.js). Get a free key at
# https://aistudio.google.com/apikey and pick a model with a free tier, e.g.
# gemini-3.5-flash-lite (the 2.5 models are closed to new keys as of
# 2026-10-20). RPM is your quota's requests per
# minute; calls are spaced to stay under it. Leave the key or model blank and the
# advice is the measured findings instead. Note: on the free tier Google may
# use what is sent to improve its products, so players' Arcade code is shared.
GEMINI_CODE_JUDGE_API_KEY=
GEMINI_CODE_JUDGE_MODEL=
GEMINI_CODE_JUDGE_RPM=10

# ---------------------------------------------------------------------------
# Deployment (added 2026-08-26, ก้อน 4)
# ---------------------------------------------------------------------------

# Port the API listens on. Most container hosts assign one and expect the
# process to use it. Defaults to 3001.
PORT=3001

# The address this deployment answers on from OUTSIDE, no trailing slash.
# Used only by links that leave the process and have to come back - today that
# is the email verification link, which is opened days later from a mail client
# and therefore cannot be relative. Defaults to http://localhost:<PORT>.
PUBLIC_BASE_URL=

# Where uploaded files are written. Point this at a mounted volume in
# production: it is the only application state that is not in the database, so
# leaving it inside the release directory means every redeploy deletes every
# profile picture. Defaults to server/uploads.
UPLOADS_DIR=

# Supabase Storage bucket for admin uploads (lesson media, cosmetic art).
# Required in production: the free host has no persistent disk. The server
# creates it as a public-read bucket on first upload. Leave blank in local
# development to keep admin uploads in UPLOADS_DIR.
ASSET_STORAGE_BUCKET=

# The built front end to serve from this same process. Defaults to
# ../client/dist. If the directory has no index.html the server just skips it,
# which is what happens during development where Vite serves on :5174.
CLIENT_DIST=

# Google sign-in is Supabase Auth's Google provider (2026-10-16). Nothing to
# set here: the login page shows the button when Supabase reports the provider
# is on. Configure it with scripts/configure-supabase-auth.js (see docs/deploy.md).

# ------------------------------------------------------------------ database
# Either one connection string, or the five PG* variables below it. A hosted
# database (Supabase, Neon, RDS) hands out a URL, so it is accepted as-is.
# For Supabase use the POOLER port 6543, not 5432: the direct endpoint is
# IPv6-only and many hosts cannot reach it.
DATABASE_URL=

# TLS is decided from the host: off for localhost and docker service names, on
# for anything else, because a managed database refuses plaintext and a local
# container does not speak TLS at all. 'disable' forces it off; any other value
# forces it on. PGSSLROOTCERT points at a CA file to verify the certificate
# properly - without one the connection is encrypted but unverified.
PGSSLMODE=
PGSSLROOTCERT=

# Server-only Data API credentials.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase Auth. Use a publishable key for password flows; secret key stays server-only.
SUPABASE_PUBLISHABLE_KEY=
# In production CLIENT_URL must exactly match PUBLIC_BASE_URL. The separate
# Vite URL above is for local development only; docker-compose overrides it.
CLIENT_URL=http://localhost:5174
AUTH_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3001,http://127.0.0.1:3001
# Custom SMTP for Supabase Auth belongs in .supabase-management.env, not here.
# The application process does not send Supabase confirmation/recovery mail.
