NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=moonshotai/kimi-k2.5
# Used only by the Arcade Battle Royale readability judge (server.js
# callClaudeForReadability) — separate from the NVIDIA integration above.
# Falls back to a heuristic score automatically if left unset.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password_here
DB_CLIENT=postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=FullProjectPython

# Chatbot AI (Lumi chat + AI exercise/challenge generator), via NVIDIA's
# OpenAI-compatible endpoint at https://integrate.api.nvidia.com/v1.
# Keep this separate from NVIDIA_CODE_JUDGE_API_KEY: that one grades Arcade
# round code on every round of every live match and must not share a budget.
# Both features fall back to built-in content when this is unset.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_AI_MODEL=moonshotai/kimi-k3
NVIDIA_AI_TIMEOUT_MS=90000

# Arcade round-code quality judge. Separate key AND separate model from the
# chatbot above on purpose: this runs at the end of every round of every live
# match, so its token budget is not spare capacity for anything else.
# Leave both blank to disable it - Arcade then scores code quality in-process
# and no player's code leaves the server.
NVIDIA_CODE_JUDGE_API_KEY=
NVIDIA_CODE_JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Deployment (added 2026-08-26, ก้อน 4)
# ---------------------------------------------------------------------------

# Port the API listens on. Most container hosts assign one and expect the
# process to use it. Defaults to 3001.
PORT=3001

# The address this deployment answers on from OUTSIDE, no trailing slash.
# Used only by links that leave the process and have to come back - today that
# is the email verification link, which is opened days later from a mail client
# and therefore cannot be relative. Defaults to http://localhost:<PORT>.
PUBLIC_BASE_URL=

# Where uploaded files are written. Point this at a mounted volume in
# production: it is the only application state that is not in the database, so
# leaving it inside the release directory means every redeploy deletes every
# profile picture. Defaults to server/uploads.
UPLOADS_DIR=

# The built front end to serve from this same process. Defaults to
# ../client/dist. If the directory has no index.html the server just skips it,
# which is what happens during development where Vite serves on :5174.
CLIENT_DIST=

# Google sign-in (added by Person 2, 2026-08-26).
# The server verifies the Google ID token against this client id AND serves it
# to the login page through /api/config/google, so the browser bundle no longer
# has to carry it. Leave blank to turn the Google button off entirely.
# Must be an OAuth *Web* client id, ending in .apps.googleusercontent.com, and
# the origin the app is served from has to be listed under "Authorized
# JavaScript origins" for it or sign-in returns 403.
GOOGLE_CLIENT_ID=
