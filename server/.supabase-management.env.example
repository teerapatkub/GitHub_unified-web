# Copy this file to .supabase-management.env only while changing project-level
# Supabase settings. The application container never loads this file.
SUPABASE_ACCESS_TOKEN=

# Setup-only Supabase Auth SMTP settings. Verify the sender/domain with the
# provider first. Never put AUTH_SMTP_PASS in server/.env or a browser build.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_SENDER=
