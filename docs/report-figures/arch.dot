 llm [label="ollama 0.30: LLM ในเครื่อง\nTyphoon 2.5 (Qwen3 4B)\nLumi · สร้างโจทย์ · คำแนะนำ"];
 {rank=same; tick; grade; llm}
 app -> tick [arrowhead=none]; app -> grade; app -> llm [label="/v1"]; }
subgraph cluster_x { label="Supabase (cloud)"; style="rounded"; color="#4a6fa5"; fontsize=13;
 db [shape=cylinder, label="PostgreSQL\n68 ตาราง", width=1.8]; auth [label="Supabase Auth\nอีเมล + Google OAuth\n(Gmail SMTP)", width=2]; store [label="Storage\nรูปที่แอดมินอัปโหลด", width=2]; }
user -> gate [label="  HTTPS · REST Polling ทุก ~2 วินาที"]; gate -> app;
user -> auth [label="เข้าสู่ระบบ", constraint=false, color="#999999"];
app -> db [label="DATABASE_URL (TLS)"]; tick -> db; app -> auth [label="ตรวจ token"]; app -> store;
note [shape=plaintext, width=0, label="AI ทุกงานรันในเครื่องตั้งแต่ 22 ต.ค. 2569 (Spec 0004) แทน NVIDIA API และ Google Gemini", fontsize=10];
