digraph A { graph [rankdir=TB, fontname="Loma", dpi=200, pad=0.3, nodesep=0.35, ranksep=0.6, newrank=true];
node [shape=box, style="rounded", color="#444444", fontname="Loma", fontsize=12, width=2.6];
edge [fontname="Loma", fontsize=10, color="#555555"];
user [label="ผู้ใช้ (เบราว์เซอร์ / มือถือ)\nReact 19 · Monaco Editor · Pyodide (ลองรันเท่านั้น)"];
gate [label="ทางเข้าสาธารณะ HTTPS\nเครื่อง server ของ มข. หรือ Tailscale Funnel"];
subgraph cluster_s { label="เครื่อง server (Docker Compose)"; style="rounded"; color="#4a6fa5"; fontsize=13;
 app [label="app: Node.js 22 + Express 5\nเสิร์ฟหน้าเว็บที่ build แล้ว + REST API /api/*", width=3.6];
 tick [label="Match Ticker ทุก 1 วินาที\nปิดรอบ Arcade · คัดออก · บอท"];
