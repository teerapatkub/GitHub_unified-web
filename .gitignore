# Dependencies
node_modules/
/client/node_modules/
/server/node_modules/

# Production Build
/client/dist/
/.security-work/

# Local Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
/server/.env

# Logs and Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# System Files
.DS_Store
Thumbs.db

# Backup Archives
**/*.zip
**/*.tar.gz

# Everything superseded but not yet thrown away: Person 2's handover copy, old
# repo archives, prototypes, and database dumps with real user rows. See
# _archive/README.md for what each one is and whether it can be deleted.
/_archive/

# Database backups and dumps can contain real user rows, email addresses, and
# password hashes. Versioned schema/migration/seed SQL remains allowed; backup
# artefacts stay outside the repository regardless of directory depth.
**/*.dump
**/*.bak
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.sql.gz
**/*backup*.sql
**/*dump*.sql

# Local agent configuration and downloaded skills. skills-lock.json IS tracked -
# it is the manifest, these are the downloaded contents (package-lock vs node_modules).
/.claude/
/.agents/

# Copies of .env made before editing it. These hold real credentials in plain
# text and must never reach the repository.
.env.backup*
*.env.backup*
